<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MuduoChatServer login and create-group" enabled="true">
      <stringProp name="TestPlan.comments">Each thread logs in and creates one existing group-management request.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="server" elementType="Argument"><stringProp name="Argument.name">server</stringProp><stringProp name="Argument.value">${__P(server,127.0.0.1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="port" elementType="Argument"><stringProp name="Argument.name">port</stringProp><stringProp name="Argument.value">${__P(port,6000)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="base_user_id" elementType="Argument"><stringProp name="Argument.name">base_user_id</stringProp><stringProp name="Argument.value">${__P(base_user_id,1001)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="password" elementType="Argument"><stringProp name="Argument.name">password</stringProp><stringProp name="Argument.value">${__P(password,123456)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan><hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="One login and one group create per account" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(threads,10)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp_time,5)}</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp></ThreadGroup><hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build login payload" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">chat_login_payload</stringProp><stringProp name="script"><![CDATA[
def id = Integer.parseInt(vars.get('base_user_id')) + ctx.getThreadNum()
vars.put('test_user_id', id.toString())
def json = '{"msgid":1,"id":' + id + ',"password":"' + vars.get('password') + '"}'
vars.put('login_request_hex', json.getBytes('UTF-8').collect { String.format('%02x', (it as int) & 255) }.join())
          ]]></stringProp></JSR223PreProcessor><hashTree/>
        <TCPSampler guiclass="TCPSamplerGui" testclass="TCPSampler" testname="Login" enabled="true"><stringProp name="TCPSampler.server">${server}</stringProp><stringProp name="TCPSampler.port">${port}</stringProp><boolProp name="TCPSampler.re_use_connection">true</boolProp><boolProp name="TCPSampler.close_connection">false</boolProp><stringProp name="TCPSampler.timeout">10000</stringProp><stringProp name="TCPSampler.request">${login_request_hex}</stringProp><stringProp name="TCPSampler.classname">org.apache.jmeter.protocol.tcp.sampler.LengthPrefixedBinaryTCPClientImpl</stringProp></TCPSampler><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login errno is zero" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">226572726e6f223a30</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_data</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">2</intProp></ResponseAssertion><hashTree/></hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build create-group payload" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">chat_group_payload</stringProp><stringProp name="script"><![CDATA[
def groupName = 'jmeter_' + vars.get('test_user_id') + '_' + System.currentTimeMillis()
def json = groovy.json.JsonOutput.toJson([msgid:9, id:Integer.parseInt(vars.get('test_user_id')), groupname:groupName, groupdesc:'JMeter latency sample'])
vars.put('group_request_hex', json.getBytes('UTF-8').collect { String.format('%02x', (it as int) & 255) }.join())
          ]]></stringProp></JSR223PreProcessor><hashTree/>
        <TCPSampler guiclass="TCPSamplerGui" testclass="TCPSampler" testname="Create group" enabled="true"><stringProp name="TCPSampler.server">${server}</stringProp><stringProp name="TCPSampler.port">${port}</stringProp><boolProp name="TCPSampler.re_use_connection">true</boolProp><boolProp name="TCPSampler.close_connection">false</boolProp><stringProp name="TCPSampler.timeout">10000</stringProp><stringProp name="TCPSampler.request">${group_request_hex}</stringProp><stringProp name="TCPSampler.classname">org.apache.jmeter.protocol.tcp.sampler.LengthPrefixedBinaryTCPClientImpl</stringProp></TCPSampler><hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Group create errno is zero" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="">226572726e6f223a30</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_data</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">2</intProp></ResponseAssertion><hashTree/></hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
